# Genesys Cloud OAuth (Client Credentials grant)
GENESYS_REGION=mypurecloud.com
CLIENT_ID=
CLIENT_SECRET=

# CSV input / output locations
MIRAMAR_FOLDER=.
OUTPUT_DIR=.

# Target queue: resolved by name unless TARGET_QUEUE_ID is set
TARGET_QUEUE_NAME=NonCall Evaluation
TARGET_QUEUE_ID=

# System user that interactions are assigned to: resolved by email unless
# INTERNAL_USER_ID is set
INTERNAL_USER_EMAIL=susernoncall@uspgi.com
INTERNAL_USER_ID=

# Email interaction identity
EMAIL_PROVIDER=ConveyNonCall@NonCall.mypurecloud.com
EMAIL_FROM_ADDRESS=noncall.qa.import@uspgi.com
EMAIL_FROM_NAME=NonCall QA Import
EMAIL_TO_ADDRESS=
EMAIL_TO_NAME=

# Timing / retry knobs
REQUEST_TIMEOUT=30
ASSIGNMENT_WAIT_SECONDS=60
POLL_INTERVAL_SECONDS=2
INTER_RECORD_DELAY_SECONDS=1
PROCESS_LIMIT=0
PRIORITY=0

# Preflight checks
REQUIRE_QUEUE_MEMBERSHIP=true
REQUIRE_ROUTABLE_USER=false
CHECK_EMAIL_UTILIZATION=true
AUTO_CONFIGURE_EMAIL_UTILIZATION=false
EMAIL_MAXIMUM_CAPACITY=1

# Close / wrap-up behavior
CLOSE_ON_SUCCESS=true
CLOSE_ON_FAILURE=true
WRAPUP_CODE_ID=
WRAPUP_CODE_NAME=Evaluated

# Optional quality evaluation creation
CREATE_EVALUATION=false
EVALUATION_FORM_ID=
EVALUATOR_USER_EMAIL=

# Idempotency / file handling
SKIP_PREVIOUS_SUCCESSES=true
RESULT_FILE_PREFIX=qa_email_insert_results
MOVE_PROCESSED_FILES=true
PROCESSED_SUBFOLDER=processed

# CSV header detection
HEADER_MARKERS=Member_ID,Member_id
MIN_HEADER_COLUMNS=3
MAX_HEADER_SCAN_LINES=30
