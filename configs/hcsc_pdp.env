# HCSC PDP Individual line of business -- six report types, each to its
# own queue. See .env.example at the repo root for the full list of
# tunable knobs.

GENESYS_REGION=mypurecloud.com
CLIENT_ID=
CLIENT_SECRET=

# This folder should contain ONLY HCSC PDP Individual's report exports
# (Approved Enrollment here is pre-filtered upstream to Enrollment Source
# "Form"/"OEC"/"OEC-Cigna" -- HCSC EGWP's copy, filtered to "Group
# Enrollment", lives in a separate folder/script).
MIRAMAR_FOLDER=\\sun1share01\CompanyShare$\IT\Reporting\NonCallQA\HCSC_PDP
OUTPUT_DIR=\\sun1share01\CompanyShare$\IT\Reporting\Genesys_API\NoncallQA\HCSC_PDP

# Filename substring -> Genesys queue name, matched case-insensitively.
# TARGET_QUEUE_NAME/TARGET_QUEUE_ID are unused while QUEUE_ROUTES is set.
# A file that matches none of these rules is skipped and logged as an
# error rather than sent anywhere -- add a rule here before it will be
# processed.
QUEUE_ROUTES=Approved Enrollment::HCSC_PDP_NONCALL_Approved_Enrollment;Invoice_Completeness_Report_Summary_Detail::HCSC_PDP_NONCALL_Invoice_Completeness;Category 2_Enrollment Maintenance Process::HCSC_PDP_NONCALL_Enrollment_Maintenance;SLA_Returned_Mail_Report::HCSC_PDP_NONCALL_Returned_Mail;Category5_BillingProcess::HCSC_PDP_NONCALL_Billing_Process;Category 6 Fulfillment Process::HCSC_PDP_NONCALL_Fulfillment_Process

INTERNAL_USER_EMAIL=susernoncall@uspgi.com
INTERNAL_USER_ID=

EMAIL_PROVIDER=ConveyNonCall@NonCall.mypurecloud.com
EMAIL_FROM_ADDRESS=noncall.qa.import@uspgi.com
EMAIL_FROM_NAME=NonCall QA Import

WRAPUP_CODE_NAME=Evaluated

# Start conservative, raise once verified: sample 1 record per file before a full run.
PROCESS_LIMIT_PER_FILE=1
PROCESS_LIMIT=0
DRY_RUN=false
