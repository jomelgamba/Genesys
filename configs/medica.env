# MEDICA line of business -- single report, single queue.
# See .env.example at the repo root for the full list of tunable knobs
# (timing, preflight toggles, wrap-up code, etc.) -- only LOB-specific
# values are set here; everything else uses the script's defaults.

GENESYS_REGION=mypurecloud.com
CLIENT_ID=
CLIENT_SECRET=

# This folder should contain ONLY Medica_Category6_Fulfillment_Process*.csv.
MIRAMAR_FOLDER=\\sun1share01\CompanyShare$\IT\Reporting\NonCallQA\Medica
OUTPUT_DIR=\\sun1share01\CompanyShare$\IT\Reporting\Genesys_API\NoncallQA\Medica

TARGET_QUEUE_NAME=MEDICA_PDP_NONCALL_Fulfillment_Process
TARGET_QUEUE_ID=

INTERNAL_USER_EMAIL=susernoncall@uspgi.com
INTERNAL_USER_ID=

EMAIL_PROVIDER=ConveyNonCall@NonCall.mypurecloud.com
EMAIL_FROM_ADDRESS=noncall.qa.import@uspgi.com
EMAIL_FROM_NAME=NonCall QA Import

WRAPUP_CODE_NAME=Evaluated

# Start conservative, raise once verified: sample 1 record before a full run.
PROCESS_LIMIT_PER_FILE=1
PROCESS_LIMIT=0
DRY_RUN=false
