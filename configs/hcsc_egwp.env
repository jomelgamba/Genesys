# HCSC EGWP line of business -- two report types, each to its own queue.
# See .env.example at the repo root for the full list of tunable knobs.

GENESYS_REGION=mypurecloud.com
CLIENT_ID=
CLIENT_SECRET=

# This folder should contain ONLY HCSC EGWP's Approved Enrollment and Group
# Invoice Report exports (each pre-filtered upstream for this LOB, e.g.
# Approved Enrollment's Enrollment Source fixed to "Group Enrollment").
MIRAMAR_FOLDER=\\sun1share01\CompanyShare$\IT\Reporting\NonCallQA\HCSC_EGWP
OUTPUT_DIR=\\sun1share01\CompanyShare$\IT\Reporting\Genesys_API\NoncallQA\HCSC_EGWP

# Filename substring -> Genesys queue name, matched case-insensitively.
# TARGET_QUEUE_NAME/TARGET_QUEUE_ID are unused while QUEUE_ROUTES is set.
# A file that matches neither rule is skipped and logged as an error rather
# than sent anywhere -- add a rule here before it will be processed.
QUEUE_ROUTES=Approved Enrollment::HCSC_EGWP_NONCALL_Approved_Enrollment;Group Invoice Report::HCSC_EGWP_NONCALL_Group_Invoice

INTERNAL_USER_EMAIL=susernoncall@uspgi.com
INTERNAL_USER_ID=

EMAIL_PROVIDER=ConveyNonCall@NonCall.mypurecloud.com
EMAIL_FROM_ADDRESS=noncall.qa.import@uspgi.com
EMAIL_FROM_NAME=NonCall QA Import

WRAPUP_CODE_NAME=Evaluated

# Start conservative, raise once verified: sample 1 record per file before a full run.
PROCESS_LIMIT_PER_FILE=1
PROCESS_LIMIT=0
DRY_RUN=false
